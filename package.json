{
  "name": "ha-lucarne",
  "version": "1.5.1",
  "private": false,
  "type": "module",
  "main": "custom_components/lucarne_family/frontend/ha-lucarne.js",
  "scripts": {
    "build": "vite build && vite build -c vite.loader.config.ts",
    "dev": "vite build --watch & BUNDLE_WATCH=$!; trap 'kill $BUNDLE_WATCH 2>/dev/null' INT TERM EXIT; vite build -c vite.loader.config.ts --watch",
    "deploy": "bash scripts/deploy-integration.sh",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "TZ=America/Los_Angeles node --import tsx --import ./tests/setup/dom-globals.mjs --test 'tests/**/*.test.ts'",
    "test:coverage": "TZ=America/Los_Angeles node --import tsx --import ./tests/setup/dom-globals.mjs --experimental-test-coverage --test-coverage-exclude='tests/**' --test-coverage-lines=88 --test-coverage-branches=80 --test-coverage-functions=73 --test 'tests/**/*.test.ts'"
  },
  "dependencies": {
    "cropperjs": "^1.6.3",
    "home-assistant-js-websocket": "^9.0.0",
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.0.0",
    "acorn": "^8.18.0",
    "eslint": "^10.9.1",
    "happy-dom": "^20.12.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
